# Application
NODE_ENV=development
SERVER_NAME=localhost

# PostgreSQL bootstrap account (created by the official image as a superuser).
# The application MUST NOT use this account.
POSTGRES_DB=techgear_db
POSTGRES_BOOTSTRAP_USER=techgear_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=

# Migration/owner role: NOT a superuser; owns the application schema.
OWNER_DB_USER=techgear_owner
OWNER_DB_PASSWORD=

# Application role: NO SUPERUSER; DML only after grants.
APP_DB_USER=techgear_app
APP_DB_PASSWORD=

# Authentication session cookie. Set COOKIE_SECURE=true for HTTPS-only production/tunnel deployments.
SESSION_COOKIE_NAME=tg_session
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false

# Cloudflare named tunnel token (needed only with compose.tunnel.yml).
# Keep secret; cloudflared reads it from TUNNEL_TOKEN internally.
CLOUDFLARE_TUNNEL_TOKEN=

# VNPAY Sandbox (credentials supplied by VNPAY; never commit secrets)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Browser redirect after payment. Must be HTTPS. Local demo can use localhost.
VNPAY_RETURN_URL=https://localhost:8443/api/payment/vnpay_return
# Server-to-server IPN URL. Leave blank locally until a public HTTPS/tunnel URL exists.
VNPAY_IPN_URL=
VNPAY_FRONTEND_ORIGIN=https://localhost:8443
VNPAY_ORDER_TYPE=other
VNPAY_LOCALE=vn
VNPAY_TIMEZONE=Asia/Ho_Chi_Minh
VNPAY_EXPIRE_MINUTES=15

# AI / encryption secrets go here, never commit .env
# AES_KEY=
# AI_API_KEY=

# TechBot Advisor (free local Ollama; optional, safe catalog fallback works without it)
TECHBOT_ENABLED=true
TECHBOT_OLLAMA_URL=http://host.docker.internal:11434
TECHBOT_MODEL=
