# ------------------------------------------------------------
# TechGear Store - Nginx + ModSecurity starter configuration
# ------------------------------------------------------------

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Common security headers are placed at server scope so the tunnel's
# HTTP origin (8080) also returns them. `always` keeps them on 4xx/5xx.
server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "OK";
    }

    # VNPAY IPN is intentionally separated for later tuning against CRS false positives.
    location = /api/payment/vnpay_ipn {
        modsecurity on;
        limit_req zone=global_limit burst=20 nodelay;
        limit_req_status 429;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${PROXY_FORWARDED_PROTO};
        proxy_set_header X-Forwarded-Port ${PROXY_FORWARDED_PORT};
        proxy_pass http://backend:5000;
    }



    location = /api/v1/payment/vnpay_ipn {
        modsecurity on;
        limit_req zone=global_limit burst=20 nodelay;
        limit_req_status 429;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${PROXY_FORWARDED_PROTO};
        proxy_set_header X-Forwarded-Port ${PROXY_FORWARDED_PORT};
        proxy_pass http://backend:5000;
    }

    location = /api/auth/login {
        modsecurity on;
        limit_req zone=strict_limit burst=3 nodelay;
        limit_req_status 429;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${PROXY_FORWARDED_PROTO};
        proxy_set_header X-Forwarded-Port ${PROXY_FORWARDED_PORT};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://backend:5000;
    }

    location = /api/payment/create {
        modsecurity on;
        limit_req zone=strict_limit burst=3 nodelay;
        limit_req_status 429;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${PROXY_FORWARDED_PROTO};
        proxy_set_header X-Forwarded-Port ${PROXY_FORWARDED_PORT};
        proxy_pass http://backend:5000;
    }



    location = /api/v1/payment/create {
        modsecurity on;
        limit_req zone=strict_limit burst=3 nodelay;
        limit_req_status 429;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${PROXY_FORWARDED_PROTO};
        proxy_set_header X-Forwarded-Port ${PROXY_FORWARDED_PORT};
        proxy_pass http://backend:5000;
    }

    location = /api/v1/auth/login {
        modsecurity on;
        limit_req zone=strict_limit burst=3 nodelay;
        limit_req_status 429;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${PROXY_FORWARDED_PROTO};
        proxy_set_header X-Forwarded-Port ${PROXY_FORWARDED_PORT};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://backend:5000;
    }

    location = /api/v1/techbot {
        modsecurity on;
        limit_req zone=ai_limit burst=1 nodelay;
        limit_req_status 429;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${PROXY_FORWARDED_PROTO};
        proxy_set_header X-Forwarded-Port ${PROXY_FORWARDED_PORT};
        proxy_pass http://backend:5000;
    }

    location = /api/techbot {
        modsecurity on;
        limit_req zone=ai_limit burst=1 nodelay;
        limit_req_status 429;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${PROXY_FORWARDED_PROTO};
        proxy_set_header X-Forwarded-Port ${PROXY_FORWARDED_PORT};
        proxy_pass http://backend:5000;
    }

    location ^~ /api/ {
        modsecurity on;
        limit_req zone=global_limit burst=20 nodelay;
        limit_req_status 429;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${PROXY_FORWARDED_PROTO};
        proxy_set_header X-Forwarded-Port ${PROXY_FORWARDED_PORT};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://backend:5000;
    }

    location / {
        modsecurity on;
        limit_req zone=global_limit burst=20 nodelay;
        limit_req_status 429;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${PROXY_FORWARDED_PROTO};
        proxy_set_header X-Forwarded-Port ${PROXY_FORWARDED_PORT};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://frontend:3000;
    }

    error_page 403 = @forbidden;
    error_page 404 = @not_found;
    error_page 429 = @rate_limited;
    error_page 500 502 503 504 = @server_error;

    location @forbidden {
        default_type application/json;
        return 403 '{"success":false,"code":"FORBIDDEN","message":"Request blocked"}';
    }

    location @not_found {
        default_type application/json;
        return 404 '{"success":false,"code":"NOT_FOUND","message":"Resource not found"}';
    }

    location @rate_limited {
        default_type application/json;
        return 429 '{"success":false,"code":"RATE_LIMITED","message":"Too many requests"}';
    }

    location @server_error {
        default_type application/json;
        return 500 '{"success":false,"code":"SERVER_ERROR","message":"Internal server error"}';
    }
}

# ------------------------- HTTPS -----------------------------
# Local TLS test. In Oracle direct mode this block will use the real
# certificate/key mounted for the production hostname.
server {
    listen ${SSL_PORT} ssl default_server;
    server_name ${SERVER_NAME};

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_protocols ${SSL_PROTOCOLS};
    ssl_ciphers ${SSL_CIPHERS};
    ssl_prefer_server_ciphers ${SSL_PREFER_CIPHERS};
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
